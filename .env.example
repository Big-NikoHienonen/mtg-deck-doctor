ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 if unset. Override to a cheaper/
# faster model (e.g. claude-haiku-4-5-20251001) for quick plumbing tests.
ANTHROPIC_MODEL=

# Optional, and off unless set. The most the Doctor may spend in a UTC day, estimated
# from token counts; once it is reached, AI calls are refused until midnight UTC.
AI_DAILY_BUDGET_USD=

# Optional. How hard the model thinks in chat (low, medium, high, max). Defaults to medium.
ANTHROPIC_CHAT_EFFORT=

# Optional. The most model calls one chat message may make. Defaults to 20.
CHAT_MAX_TOOL_ROUNDS=

# The owner's password. Required wherever the backend is reachable by anyone but you: without one, every
# route but the share links refuses all requests. ./dev-backend.sh runs open when this is empty, so local
# work needs no password. Setting one here turns the login on locally too. Changing it signs everyone out.
MTG_DECK_DOCTOR_PASSWORD=
